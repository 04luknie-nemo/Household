# Kopiera till server/.env och fyll i värdena (se setup/README.md)
# Variablerna kommer från Better Auth: https://better-auth.com/docs/installation

DATABASE_URL="file:./data/dev.db"

# Slumpad hemlighet, generera med:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Adressen GitHub skickar tillbaka till efter inloggning.
# Ha en rad aktiv och kommentera bort de andra. Starta om servern efter byte.
BETTER_AUTH_URL=http://localhost:3000                       # Webb
# BETTER_AUTH_URL=http://<din-ip>:3000                      # Android
# BETTER_AUTH_URL=https://<din-tunnel>.trycloudflare.com    # iPhone (GitHub-inloggning)

# Valfria. Bara för GitHub-inloggning, från din egen GitHub OAuth App (se setup/README.md).
# Lämna tomma för e-post och lösenord.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Krävs för att Expo Go (exp://) och Expo web ska vara betrodda
NODE_ENV=development
